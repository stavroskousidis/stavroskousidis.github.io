---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/site';
---

<BaseLayout
  title="Privacy · Stavros Kousidis"
  description="Privacy information for the personal academic website of Stavros Kousidis."
>
  <section class="page-intro">
    <p class="kicker">Personal academic website</p>
    <h1>Privacy.</h1>
    <p class="lede">Concise information about the operation of this website and its anonymous usage statistics.</p>
  </section>

  <section class="prose-grid privacy-grid">
    <article>
      <span>01 · Operator</span>
      <h2>About this website</h2>
      <p>
        This is the personal academic website of {profile.name}. It is not an official website of TH Köln.
        Questions about this website can be sent to <a class="text-link" href={`mailto:${profile.email}`}>{profile.email}</a>.
      </p>
    </article>

    <article>
      <span>02 · Analytics</span>
      <h2>Anonymous statistics</h2>
      <p>
        This website uses Umami Analytics to collect anonymous, aggregated usage statistics. Umami does not use
        cookies and does not create persistent personal profiles. The collected information helps me understand
        which pages are visited and how visitors reach this website. No user accounts, personal identifiers,
        custom events or advertising profiles are used.
      </p>
    </article>

    <article>
      <span>03 · Provider</span>
      <h2>Umami Cloud</h2>
      <p>
        The analytics service is provided by Umami Software, Inc., 28 Geary St, Suite 650 #243, San Francisco,
        California, United States. Further information is available in
        <a class="text-link" href="https://umami.is/privacy">Umami’s privacy policy</a>.
      </p>
    </article>

    <article>
      <span>04 · Hosting</span>
      <h2>GitHub Pages</h2>
      <p>
        This website is hosted through GitHub Pages. When the site is accessed, GitHub may process technical
        connection data required to deliver it. Further information is available in
        <a class="text-link" href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">GitHub’s privacy statement</a>.
      </p>
    </article>
  </section>
</BaseLayout>
