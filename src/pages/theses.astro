---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThesisCard from '../components/ThesisCard.astro';
import { profile } from '../data/site';
import { getCollection } from 'astro:content';

const theses = (await getCollection('theses'))
  .filter((topic) => topic.data.status !== 'Assigned')
  .sort((a, b) => a.data.level.localeCompare(b.data.level));
---

<BaseLayout
  title="Theses · Stavros Kousidis"
  description="Bachelor's and Master's theses: supervision, expectations, getting started, and available topics in Cyber Security Engineering."
>
  <section class="page-intro">
    <p class="kicker">Work with me</p>
    <h1>Bachelor's and Master's theses.</h1>
    <p class="lede">
      A good thesis starts with a well-defined question. The goal is to investigate it
      systematically, explain your decisions, and support your conclusions with evidence.
      Here is how I approach supervision and how you can get started.
    </p>
  </section>

  <section class="section" aria-labelledby="expectations">
    <div class="section-heading">
      <div><p class="kicker">Supervision</p><h2 id="expectations">What to expect</h2></div>
    </div>
    <div class="thesis-guidelines">
      <article>
        <p class="kicker">01 · Research</p>
        <h3>Start with a question.</h3>
        <p>
          A clearly formulated research question is the foundation of your thesis.
          Implementation can be part of the investigation, but producing software alone
          is not a scientific result. A Bachelor's thesis typically applies and evaluates
          established methods in a defined scope; a Master's thesis calls for deeper
          engagement with prior work and greater methodological independence.
        </p>
      </article>
      <article>
        <p class="kicker">02 · Independence</p>
        <h3>Take increasing ownership.</h3>
        <p>
          Becoming more independent is part of the learning process, not a prerequisite.
          You are responsible for your work and decisions, while I help you develop the
          skills to make and defend them. We meet regularly to discuss progress and
          identify where you may need support.
        </p>
      </article>
      <article>
        <p class="kicker">03 · Research practice</p>
        <h3>Keep your work coherent.</h3>
        <p>
          Each student works in an individual private GitHub repository. Organize thesis sources,
          code, experiments, documentation, and results so that your work is traceable
          and, where possible, reproducible. Respect confidentiality, data protection,
          and licensing constraints. I can help with advanced Git workflows, including
          forks, branches, and remotes.
        </p>
      </article>
      <article>
        <p class="kicker">04 · Communication</p>
        <h3>Ask early and thoughtfully.</h3>
        <p>
          Do not struggle silently for weeks. Raise questions in GitHub Issues using
          the provided template: <em>Question</em>,
          <em>Context</em>, and <em>My current understanding</em>.
          This helps us work from what you have already investigated. Regular meetings
          complement the repository and its issue discussions.
        </p>
      </article>
      <article>
        <p class="kicker">05 · Writing</p>
        <h3>Write in English.</h3>
        <p>
          The thesis must be written in English using the TH Köln LaTeX thesis template.
          If you wish, you may separately adapt the template to Quarto to work with
          Markdown and LaTeX, potentially including Jupyter or Marimo notebooks.
          I welcome this, but it is entirely optional and not part of your thesis work.
        </p>
      </article>
      <article>
        <p class="kicker">06 · AI tools</p>
        <h3>Use AI, but understand your work.</h3>
        <p>
          AI-assisted tools are permitted. You remain responsible for the correctness,
          integrity, and intellectual ownership of everything you submit. You must be
          able to explain, verify, and defend your text, code, methods, and findings,
          including AI-assisted material. Follow the applicable academic integrity rules.
        </p>
      </article>
    </div>
  </section>

  <section class="section" aria-labelledby="getting-started">
    <div class="section-heading">
      <div><p class="kicker">Before you begin</p><h2 id="getting-started">How to get started</h2></div>
    </div>
    <div class="thesis-steps">
      <article>
        <span class="thesis-step-number">01</span>
        <h3>Explore a topic.</h3>
        <p>
          Look through the available topics below, or propose your own idea related
          to my research interests. Think about the concrete question you would like
          to answer.
        </p>
      </article>
      <article>
        <span class="thesis-step-number">02</span>
        <h3>Get in touch.</h3>
        <p>
          Email me your degree programme, Bachelor's or Master's level, preferred
          starting period, topic of interest, and a short description of your
          motivation and relevant background. An initial research question helps;
          a finished proposal is not required.
        </p>
      </article>
      <article>
        <span class="thesis-step-number">03</span>
        <h3>Define the work.</h3>
        <p>
          We will refine the question, scope, methods, and expected outcomes together.
          Once these are clear, we can agree on the working arrangements and next
          steps before formal registration under your degree programme's rules.
        </p>
      </article>
    </div>
    <p class="thesis-contact">
      Interested? <a class="text-link" href={`mailto:${profile.email}?subject=Thesis%20inquiry`}>Contact me by email <span aria-hidden="true">↗</span></a>
    </p>
  </section>

  <section class="section thesis-opportunities" aria-labelledby="available-topics">
    <div class="section-heading">
      <div><p class="kicker">Opportunities</p><h2 id="available-topics">Available topics</h2></div>
    </div>
    {
      theses.length > 0 ? (
        <div class="card-grid">{theses.map((thesis) => <ThesisCard entry={thesis} />)}</div>
      ) : (
        <p class="muted thesis-empty">
          Individual topics will be published here as they become
          available. In the meantime, you are welcome to propose a suitable research question.
        </p>
      )
    }
  </section>
</BaseLayout>
