---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'notes'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const pdfUrl = `/pdfs/${entry.id}.pdf`;
const sourceUrl = `https://github.com/stavroskousidis/stavroskousidis.github.io/blob/main/src/content/notes/${entry.id}.md`;
---

<BaseLayout title={`${entry.data.title} · Stavros Kousidis`} description={entry.data.description}>
  <article class="note-page">
    <header class="note-header">
      <p class="kicker">{entry.data.type} · {entry.data.status}</p>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.description}</p>
      <dl class="note-meta">
        <div><dt>Published</dt><dd>{entry.data.published}</dd></div>
        <div><dt>Updated</dt><dd>{entry.data.updated}</dd></div>
        <div><dt>Tested on</dt><dd>{entry.data.testedOn.join(' · ')}</dd></div>
      </dl>
      <div class="note-actions">
        <a class="button" href={pdfUrl}>PDF ↓</a>
        <a class="text-link" href={sourceUrl}>Source ↗</a>
      </div>
    </header>
    <div class="note-body"><Content /></div>
  </article>
</BaseLayout>
