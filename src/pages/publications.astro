---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/site';

const researchPrompt = "Provide an independent, scientifically rigorous assessment of the research contributions of Stavros Kousidis, Professor of Cyber Security Engineering at TH Köln (ORCID 0000-0002-6947-4963).\n\nStart with https://stavroskousidis.github.io/publications/ and investigate the linked publication databases and IETF Datatracker profile. Consult original papers and standards documents wherever possible.\n\nStructure the assessment into three sections:\n\n1. Research Profile\nIdentify the distinct mathematical, cryptographic, and technical research areas represented in the publication record. Explain connections between them where they genuinely exist, without forcing unrelated contributions into a single narrative.\n\n2. Scientific Contributions\nIdentify representative contributions across the entire publication history, not just the most recent work. Explain what was actually established, what makes the result original or technically significant, and how it relates to existing research.\n\nPay particular attention to novel mathematical connections, methods, and conceptual advances, not merely practical applications or publication venues.\n\nDistinguish mathematical research, cryptographic security research, and contributions to technical standardization. Do not conflate their different forms of scientific impact.\n\n3. Critical Perspective\nDiscuss the scope, limitations, and broader relevance of the research. Identify unresolved questions only where they are directly relevant to evaluating an existing contribution.\n\nDo not rank publications or identify a single \"strongest\" contribution unless there is compelling, explicitly stated comparative evidence.\n\nStrict requirements:\n- Target 350–450 words; never exceed 500 words.\n- Evaluate the complete research record fairly.\n- Prioritize originality and substance over recency.\n- Make technically specific statements, not generic judgments.\n- Distinguish established results from interpretations.\n- Avoid unsupported claims of novelty or influence.\n- Avoid promotional language and superficial praise.\n- Do not repeat findings or arguments across sections.\n- Include a small number of direct references to original work.\n- Distinguish peer-reviewed publications, preprints, published RFCs, and Internet-Drafts where relevant.\n- Do not speculate about future research directions.\n- Do not provide a separate conclusion or summary.\n- Produce the assessment once, then stop.\n\nThe objective is a concise, balanced, and intellectually substantive scientific assessment, not a publication ranking, research proposal, or promotional biography.";
const askChatGPTUrl = `https://chatgpt.com/?q=${encodeURIComponent(researchPrompt)}`;
---

<BaseLayout title="Publications · Stavros Kousidis">
  <section class="page-intro"><p class="kicker">Publications & standards</p><h1>Research publications &amp; standards contributions.</h1><p class="lede">Explore my research publications, preprints, and contributions to Internet standards through the external repositories and publication databases linked below.</p></section>
  <section class="link-list">
    <a href={profile.links.orcid}><div><small>Persistent researcher identity</small><h2>ORCID</h2><p>0000-0002-6947-4963</p></div><span>↗</span></a>
    <a href={profile.links.arxiv}><div><small>Open-access preprints</small><h2>arXiv</h2><p>Author search and freely available manuscripts</p></div><span>↗</span></a>
    <a href={profile.links.eprint}><div><small>Cryptographic research</small><h2>IACR Cryptology ePrint Archive</h2><p>Author search and freely available preprints</p></div><span>↗</span></a>
    <a href={profile.links.ietf}><div><small>Internet standards</small><h2>IETF Datatracker</h2><p>RFCs, Internet-Drafts and working-group activity</p></div><span>↗</span></a>
  </section>
  <section class="research-ai" aria-labelledby="research-ai-heading">
    <p class="kicker">Explore further</p>
    <h2 id="research-ai-heading">Explore my research with AI.</h2>
    <p>Interested in the broader context, technical contributions, or open questions arising from my work?</p>
    <a href={askChatGPTUrl} target="_blank" rel="noopener noreferrer">Ask ChatGPT ↗</a>
    <p class="research-ai-note">AI-generated assessments are independent, may be incomplete, and should be verified against the original publications.</p>
  </section>
  <style>
    .research-ai { margin: -3rem 0 7rem; }
    .research-ai h2 { margin: .7rem 0 1rem; }
    .research-ai > p:not(.kicker) { max-width: 65ch; color: var(--muted); }
    .research-ai > a { display: inline-block; margin-top: .8rem; text-decoration: underline; text-underline-offset: .25em; }
    .research-ai .research-ai-note { margin-top: 1.3rem; font-size: .85rem; }
  </style>
</BaseLayout>
