---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/site';

const researchPrompt = "Assess the scientific contributions of Stavros Kousidis (ORCID 0000-0002-6947-4963) independently, rigorously, and critically.\n\nStart at https://stavroskousidis.github.io/publications/ and follow the linked publication databases and IETF Datatracker record. Survey the complete publication history and consult original research papers, preprints, and RFCs wherever possible. Do not rely on publication titles, abstracts, or secondary summaries when assessing technical contributions.\n\nThe objective is to identify and explain the most significant scientific contributions, not to summarize a publication list or construct a favorable academic profile.\n\nApply the following principles:\n\n1. **Selection by scientific significance.** Select contributions based on demonstrable originality, mathematical depth, conceptual advances, and significance relative to existing research. Do not sample publications merely to represent different periods or research areas. Give less space to incremental or less significant work, regardless of publication date or venue.\n2. **Technical substance.** Explain what was actually proved, constructed, generalized, or established. Identify the central mathematical ideas, methods, and results. Pay particular attention to unexpected connections between mathematical theories and to techniques that make previously inaccessible problems tractable. Distinguish genuinely new methods from applications of established techniques.\n3. **Relationship to prior research.** For each major contribution, explain what was previously known, what specific obstacle or open question was addressed, and precisely how the work advances the state of knowledge. Distinguish original discoveries from extensions, generalizations, alternative proofs, and applications. Do not attribute established mathematical principles to the author merely because they play a central role in a publication.\n4. **Research diversity.** Identify the distinct research areas represented in the publication history without imposing an artificial unifying narrative. Explain meaningful connections between contributions where they exist, while recognizing genuine changes in research direction.\n5. **Different forms of contribution.** Distinguish mathematical research, computational and cryptanalytic methods, cryptographic security results, and technical standardization. Evaluate each according to appropriate criteria. In particular, distinguish new theorems and security proofs from protocol design, interoperability specifications, and engineering contributions.\n6. **Evidence and publication status.** Separate peer-reviewed publications, preprints, published RFCs, and Internet-Drafts. Verify technically specific claims against primary sources. Do not infer scientific significance from publication venues, citation counts, or standardization activity alone.\n7. **Critical assessment.** Identify substantive limitations, assumptions, and unresolved questions specific to the selected contributions. Distinguish limitations of individual results from limitations of their applicability. Avoid generic qualifications that could apply to almost any mathematical or cryptographic paper. Do not speculate about long-term influence, reception, or practical impact without supporting evidence.\n\nStructure the assessment into exactly three sections:\n\n**1. Research Profile**\n\nIdentify the principal research areas and characterize their intellectual relationships. Keep this section concise.\n\n**2. Scientific Contributions**\n\nConcentrate on the most substantial results across the publication history. Explain their originality, technical content, relationship to prior work, and broader mathematical or cryptographic significance. Allocate space according to scientific substance, not chronology. Discuss fewer contributions in greater depth when necessary.\n\n**3. Critical Perspective**\n\nProvide a balanced evaluation of the scope, limitations, and significance of the research. Address concrete methodological or theoretical limitations rather than offering generic criticism.\n\nUse direct links to original papers and standards documents to substantiate technical assessments.\n\nMaintain an analytical, academically neutral tone. Avoid promotional language, biographical embellishment, unsupported superlatives, and artificial continuity between unrelated contributions.\n\n**Write 400–500 words, never exceeding 500 words. Do not add a separate introduction, conclusion, or bibliography.**\n\nThe central criterion is **scientific originality and intellectual substance, not completeness of representation**. A contribution should receive attention because it materially advances understanding, not simply because it appears in the publication record.";
const askChatGPTUrl = `https://chatgpt.com/?q=${encodeURIComponent(researchPrompt)}`;
---

<BaseLayout title="Publications · Stavros Kousidis">
  <section class="page-intro"><p class="kicker">Publications & standards</p><h1>Research publications &amp; standards contributions.</h1><p class="lede">Explore my research publications, preprints, and contributions to Internet standards through the external repositories and publication databases linked below.</p></section>
  <section class="link-list">
    <a href={profile.links.orcid}><div><small>Persistent researcher identity</small><h2>ORCID</h2><p>0000-0002-6947-4963</p></div><span>↗</span></a>
    <a href={profile.links.arxiv}><div><small>Open-access preprints</small><h2>arXiv</h2><p>Author search and freely available manuscripts</p></div><span>↗</span></a>
    <a href={profile.links.eprint}><div><small>Cryptographic research</small><h2>IACR Cryptology ePrint Archive</h2><p>Author search and freely available preprints</p></div><span>↗</span></a>
    <a href={profile.links.ietf}><div><small>Internet standards</small><h2>IETF Datatracker</h2><p>RFCs, Internet-Drafts and working-group activity</p></div><span>↗</span></a>
    <a href={profile.links.hochschulbibliografie}><div><small>Institutional publication index</small><h2>TH Köln Digital University Bibliography</h2><p>Search TH Köln’s institutional bibliography for my publications</p></div><span>↗</span></a>
  </section>
  <section class="research-ai" aria-labelledby="research-ai-heading">
    <p class="kicker">Explore further</p>
    <h2 id="research-ai-heading">Explore my research with AI.</h2>
    <p>Interested in the broader context, technical contributions, or open questions arising from my work?</p>
    <a href={askChatGPTUrl} target="_blank" rel="noopener noreferrer">Ask ChatGPT ↗</a>
    <p class="research-ai-note">AI-generated assessments are independent, may be incomplete, and should be verified against the original publications.</p>
  </section>
  <style>
    .research-ai { margin: -3rem 0 7rem; }
    .research-ai h2 { margin: .7rem 0 1rem; }
    .research-ai > p:not(.kicker) { max-width: 65ch; color: var(--muted); }
    .research-ai > a { display: inline-block; margin-top: .8rem; text-decoration: underline; text-underline-offset: .25em; }
    .research-ai .research-ai-note { margin-top: 1.3rem; font-size: .85rem; }
  </style>
</BaseLayout>
