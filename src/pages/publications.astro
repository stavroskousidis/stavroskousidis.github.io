---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/site';

const researchPrompt = "Assess the scientific contributions of Stavros Kousidis (ORCID 0000-0002-6947-4963) independently and critically.\nStart at https://stavroskousidis.github.io/publications/ and follow the linked publication databases and IETF record.\nSurvey the complete publication history and consult original papers and RFCs where possible.\nDo not sample publications merely to represent each time period; select contributions by demonstrable originality, depth, and significance.\nIdentify the main research areas without inventing a single unifying narrative.\nExplain the most substantive results and what was actually proved or established, including novel mathematical connections and methods.\nGive less space to incremental or less significant work, regardless of date.\nDistinguish mathematical research, cryptographic security results, and technical standardization.\nSeparate peer-reviewed results, preprints, published RFCs, and Internet-Drafts.\nDiscuss meaningful limitations and context without speculation or promotional claims.\nSupport technically specific assessments with direct links to primary sources.\nUse three sections: Research Profile; Scientific Contributions; Critical Perspective.\nWrite 350–450 words, never more than 500, and do not add a conclusion.";
const askChatGPTUrl = `https://chatgpt.com/?q=${encodeURIComponent(researchPrompt)}`;
---

<BaseLayout title="Publications · Stavros Kousidis">
  <section class="page-intro"><p class="kicker">Publications & standards</p><h1>Research publications &amp; standards contributions.</h1><p class="lede">Explore my research publications, preprints, and contributions to Internet standards through the external repositories and publication databases linked below.</p></section>
  <section class="link-list">
    <a href={profile.links.orcid}><div><small>Persistent researcher identity</small><h2>ORCID</h2><p>0000-0002-6947-4963</p></div><span>↗</span></a>
    <a href={profile.links.arxiv}><div><small>Open-access preprints</small><h2>arXiv</h2><p>Author search and freely available manuscripts</p></div><span>↗</span></a>
    <a href={profile.links.eprint}><div><small>Cryptographic research</small><h2>IACR Cryptology ePrint Archive</h2><p>Author search and freely available preprints</p></div><span>↗</span></a>
    <a href={profile.links.ietf}><div><small>Internet standards</small><h2>IETF Datatracker</h2><p>RFCs, Internet-Drafts and working-group activity</p></div><span>↗</span></a>
    <a href={profile.links.hochschulbibliografie}><div><small>Institutional publication index</small><h2>TH Köln Digital University Bibliography</h2><p>Search TH Köln’s institutional bibliography for my publications</p></div><span>↗</span></a>
  </section>
  <section class="research-ai" aria-labelledby="research-ai-heading">
    <p class="kicker">Explore further</p>
    <h2 id="research-ai-heading">Explore my research with AI.</h2>
    <p>Interested in the broader context, technical contributions, or open questions arising from my work?</p>
    <a href={askChatGPTUrl} target="_blank" rel="noopener noreferrer">Ask ChatGPT ↗</a>
    <p class="research-ai-note">AI-generated assessments are independent, may be incomplete, and should be verified against the original publications.</p>
  </section>
  <style>
    .research-ai { margin: -3rem 0 7rem; }
    .research-ai h2 { margin: .7rem 0 1rem; }
    .research-ai > p:not(.kicker) { max-width: 65ch; color: var(--muted); }
    .research-ai > a { display: inline-block; margin-top: .8rem; text-decoration: underline; text-underline-offset: .25em; }
    .research-ai .research-ai-note { margin-top: 1.3rem; font-size: .85rem; }
  </style>
</BaseLayout>
