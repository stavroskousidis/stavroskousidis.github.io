---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { profile } from '../../data/site';

export async function getStaticPaths() {
  const topics = await getCollection('theses');
  return topics.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'theses'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} · Stavros Kousidis`} description={entry.data.summary}>
  <article class="note-page">
    <header class="note-header">
      <p class="kicker">{entry.data.level} thesis · {entry.data.status} · {entry.data.researchDirection}</p>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.summary}</p>
    </header>
    <div class="note-body">
      <h2>Research question</h2>
      <p>{entry.data.researchQuestion}</p>
      <Content />
      <p>
        Interested? <a href={`mailto:${profile.email}?subject=Thesis%20inquiry`}>Get in touch by email</a>.
        Please also read the <a href="/theses">supervision and application guidelines</a>.
      </p>
    </div>
  </article>
</BaseLayout>