---
import BaseLayout from '../../layouts/BaseLayout.astro';
import course from '../../data/bvs1-semesters.json';

const { courseTitle, current, semesters } = course;
---

<BaseLayout
  title={`${courseTitle} · Teaching · Stavros Kousidis`}
  description={`Course material and semester archive for ${courseTitle} at TH Köln, ICCT.`}
>
  <section class="page-intro">
    <p class="kicker">Teaching · {courseTitle}</p>
    <h1>{courseTitle}</h1>
    <p class="lede">Course material is published per semester for students attending BVS1 from multiple Bachelor programmes. The HTML script is the primary online version, with a PDF script and lecture slides available from each semester site.</p>
  </section>

  <section class="link-list">
    <a href={current.href}>
      <div>
        <small>Current semester</small>
        <h2>{current.label}</h2>
        <p>HTML course script, downloadable PDF script, and lecture slides.</p>
      </div>
      <span aria-hidden="true">→</span>
    </a>
  </section>

  <section class="section">
    <div class="section-heading">
      <div>
        <p class="kicker">Archive</p>
        <h2>Semester snapshots</h2>
      </div>
    </div>
    <div class="link-list">
      {semesters.map((semester) => (
        <a href={semester.href}>
          <div>
            <small>{semester.id === current.id ? 'Current' : 'Archived'}</small>
            <h2>{semester.label}</h2>
          </div>
          <span aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="note">
    <div>
      <p class="kicker">Reproducibility</p>
      <h2>Frozen source snapshots</h2>
    </div>
    <p>Completed semesters remain available under their semester-specific URLs. The corresponding private course sources are frozen with annotated Git tags so past teaching material can be reproduced exactly.</p>
  </section>
</BaseLayout>
