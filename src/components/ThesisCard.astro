---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'theses'>;
}

const { entry } = Astro.props;
---

<article class="thesis-card">
  <div class="eyebrow">
    <span>{entry.data.level} thesis</span>
    <span class:list={['status', entry.data.status.toLowerCase().replaceAll(' ', '-')]}>{entry.data.status}</span>
  </div>
  <h3><a href={`/theses/${entry.id}`}>{entry.data.title}</a></h3>
  <p>{entry.data.summary}</p>
  <ul class="tags" aria-label="Topics">
    {entry.data.tags.map((tag) => <li>{tag}</li>)}
  </ul>
  <a class="text-link" href={`/theses/${entry.id}`}>Read thesis description <span aria-hidden="true">→</span></a>
</article>